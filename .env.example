# PS1 Generator — environment
# Copy this file to `.env` and customise.
#
# The container image reads OLS_ADMIN_USER / OLS_ADMIN_PASSWORD to seed
# the WebAdmin (port 7080) htpasswd on first boot. After that the file
# inside the container is the source of truth; changing these env vars
# won't rotate the password until you recreate the container.

# --- Host ports ---
# Host-side port mappings. The container always listens on :80 / :443.
HTTP_PORT=80
HTTPS_PORT=443

# --- OpenLiteSpeed WebAdmin (port 7080) ---
# Credentials used by the entrypoint to seed /usr/local/lsws/admin/conf/htpasswd.
OLS_ADMIN_USER=admin
OLS_ADMIN_PASSWORD=changeme
